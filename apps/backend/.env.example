PORT=4000

# Supabase project settings (dashboard > Project Settings > API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string (dashboard > Project Settings > Database > Connection string > URI)
# Use the service-role/pooler connection — the backend enforces authorization in queries,
# it does not rely on RLS via per-user JWT forwarding.
DATABASE_URL=

# Email-sync (Gmail OAuth + Gemini AI auto-registration of transactions)
# Google Cloud Console > OAuth client (Web application). Redirect URI must be an
# https:// URL (or http://localhost) — Google rejects LAN IPs, hence the ngrok tunnel.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Free API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 32 random bytes, base64-encoded: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_SYNC_ENCRYPTION_KEY=
EMAIL_SYNC_LLM_MODEL=gemini-flash-latest
EMAIL_SYNC_MIN_CONFIDENCE=0.7
EMAIL_SYNC_MAX_MESSAGES_PER_RUN=50
